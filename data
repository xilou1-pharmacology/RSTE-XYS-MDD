fc = deg["logFC"].values
p = deg["P.Value"].values
y = -np.log10(np.clip(p, 1e-300, 1))
sig = (p < 0.05)
up, dn = sig & (fc > 0), sig & (fc < 0)
ax.scatter(fc[~sig], y[~sig], s=4, c="#CFD8DC", alpha=0.55, edgecolors="none", rasterized=True)
