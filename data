#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
06_pathway_convergence.py (v2) — 通路层面收敛检验（Enrichr GMT 版）
"""
import os, math
import sys
from pathlib import Path
_ROOT = Path(__file__).resolve().parents[1]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))
sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import ROOT
from collections import defaultdict

ROOT = str(ROOT)
GMT_DIR = os.path.join(ROOT, "data/raw/kegg")
OUT = os.path.join(ROOT, "results")
os.makedirs(OUT, exist_ok=True)

def read_gmt(path):
    sets = {}
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            p = line.rstrip("\n").split("\t")
            if len(p) < 3: continue
            term = p[0].strip()
            genes = {x.strip().upper() for x in p[2:] if x.strip()}
            if genes: sets[term] = genes
    return sets

KEGG = read_gmt(os.path.join(GMT_DIR, "KEGG_2021_Human.gmt"))
GOBP = read_gmt(os.path.join(GMT_DIR, "GO_Biological_Process_2021.gmt"))
print(f"KEGG 通路 {len(KEGG)} | GO BP {len(GOBP)}")

def read_col(path):
    out = []
    with open(path, encoding="utf-8") as f:
        for i, l in enumerate(f):
            if i == 0: continue
            p = l.rstrip("\n").split("\t")
            if p and p[0].strip(): out.append(p[0].strip().upper())
    return out

XY = set(read_col(os.path.join(ROOT, "data/processed/XYS_targets_OB30DL018.tsv")))
print("逍遥散靶点:", len(XY))

rows = []
with open(os.path.join(ROOT, "data/processed/deg_blood.tsv"), encoding="utf-8") as f:
    f.readline()
    for l in f:
        p = l.rstrip("\n").split("\t")
        if len(p) >= 6:
            try: rows.append((p[0].upper(), float(p[1]), float(p[4]), float(p[5])))
            except ValueError: pass

UNIVERSE = {r[0] for r in rows}
print("检测基因:", len(UNIVERSE))

DEG05 = {r[0] for r in rows if r[2] < 0.05}
DEG_LFC = {r[0] for r in rows if r[2] < 0.05 and abs(r[1]) >= 0.25}
DEG_01 = {r[0] for r in rows if r[2] < 0.01}
print(f"DEG P<0.05: {len(DEG05)} | P<0.05&|logFC|>=0.25: {len(DEG_LFC)} | P<0.01: {len(DEG_01)}")

def hyper(k, K, n, N):
    if n == 0 or K == 0: return 1.0
    lo = max(0, n + K - N)
    if k <= lo: return 1.0
    return sum(math.comb(K, x) * math.comb(N - K, n - x)
               for x in range(k, min(n, K) + 1)) / math.comb(N, n)

def enrich(query, sets, universe, min_size=5, max_size=500):
    q = query & universe
    res = []
    N = len(universe); n = len(q)
    for term, genes in sets.items():
        mem = genes & universe
        if len(mem) < min_size or len(mem) > max_size: continue
        k = len(mem & q)
        if k < 2: continue
        res.append([term, k, len(mem), n, hyper(k, len(mem), n, N)])
    res.sort(key=lambda r: r[4])
    m = len(res); prev = 1.0
    for i in range(m - 1, -1, -1):
        v = min(prev, res[i][4] * m / (i + 1)); prev = v
        res[i].append(min(1.0, v))
    return res

def save(res, name):
    with open(os.path.join(OUT, name), "w", encoding="utf-8") as f:
        f.write("term\thits\tsize\tquery\tP\tFDR\n")
        for r in res: f.write("\t".join(map(str, r)) + "\n")
    sig = sum(1 for r in res if r[5] < 0.05)
    print(f"  {name:28s} {len(res):4d} 条, FDR<0.05: {sig}")

print("\n=== 富集 ===")
RX_K = enrich(XY, KEGG, UNIVERSE);  save(RX_K, "pw_XYS_KEGG.tsv")
RD_K = enrich(DEG05, KEGG, UNIVERSE); save(RD_K, "pw_DEG05_KEGG.tsv")
RD2_K = enrich(DEG_LFC, KEGG, UNIVERSE); save(RD2_K, "pw_DEGlfc_KEGG.tsv")
RX_G = enrich(XY, GOBP, UNIVERSE);  save(RX_G, "pw_XYS_GOBP.tsv")
RD_G = enrich(DEG05, GOBP, UNIVERSE); save(RD_G, "pw_DEG05_GOBP.tsv")

def top_terms(res, q=0.05, top=30):
    s = {r[0] for r in res if r[5] < q}
    return s if s else {r[0] for r in res[:top]}

for name, a, b in [("KEGG: XYS vs DEG(P<0.05)", RX_K, RD_K),
                   ("KEGG: XYS vs DEG(P<0.05,|FC|>=.25)", RX_K, RD2_K),
                   ("GOBP: XYS vs DEG(P<0.05)", RX_G, RD_G)]:
    sa, sb = top_terms(a), top_terms(b)
    sh = sa & sb
    print(f"\n[{name}] XYS={len(sa)} DEG={len(sb)} 共享={len(sh)}")
    for t in sorted(sh)[:15]: print("    -", t)

print("\n=== XYS 靶点 Top10 KEGG ===")
for r in RX_K[:10]: print(f"  {r[0][:55]:55s} hits={r[1]:3d} P={r[4]:.2g} FDR={r[5]:.2g}")

print("\n=== DEG Top10 KEGG ===")
for r in RD_K[:10]: print(f"  {r[0][:55]:55s} hits={r[1]:3d} P={r[4]:.2g} FDR={r[5]:.2g}")


#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
07_mr_cis.py — cis-eQTL 孟德尔随机化（本地文件，不联网）

暴露：eQTLGen cis-eQTL（FDR<0.05，按 P 排序）
结局：FinnGen R12 F5_DEPRESSIO
对象：PPI top hub 基因

逻辑：每个基因取最强 cis-eQTL 作工具变量（单 SNP → Wald ratio）
      F = (beta/se)^2，F>10 才保留
"""
import sys
from pathlib import Path
_ROOT = Path(__file__).resolve().parents[1]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))
sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import ROOT

import gzip, math, os, csv, json

ROOT = str(ROOT)
EQTL = os.path.join(ROOT, "data/raw/mr/eqtlgen_cis_eQTL_FDR05.txt.gz")
FINN = os.path.join(ROOT, "data/raw/mr/finngen_R12_F5_DEPRESSIO.gz")
DEGREE = os.path.join(ROOT, "data/processed/ppi_degree.tsv")
OUT = os.path.join(ROOT, "results")
os.makedirs(OUT, exist_ok=True)

# hub 基因：PPI 度数 top 20
hubs = []
with open(DEGREE, encoding="utf-8") as f:
    rd = csv.DictReader(f, delimiter="\t")
    for i, r in enumerate(rd):
        if i >= 20: break
        hubs.append(r["gene"])
hubs = set(hubs)
print("hub 基因:", sorted(hubs))

# ---- 1. eQTLGen：每个基因取最小 P ----
best = {}
n = 0
with gzip.open(EQTL, "rt", encoding="utf-8", errors="replace") as f:
    hdr = f.readline().rstrip("\n").split("\t")
    idx = {c: i for i, c in enumerate(hdr)}
    while True:
        try:
            line = f.readline()
        except EOFError:
            print("  [warn] eQTLGen 文件截断，继续使用已读部分"); break
        if not line: break
        n += 1
        p = line.rstrip("\n").split("\t")
        if len(p) < len(hdr): continue
        gs = p[idx["GeneSymbol"]]
        if gs not in hubs: continue
        try:
            pv = float(p[idx["Pvalue"]])
        except ValueError:
            continue
        if gs not in best or pv < best[gs]["p"]:
            best[gs] = dict(p=pv, snp=p[idx["SNP"]], ea=p[idx["AssessedAllele"]],
                            oa=p[idx["OtherAllele"]],
                            beta=float(p[idx["Zscore"]]) / 1.0,
                            z=float(p[idx["Zscore"]]), n=int(float(p[idx["NrSamples"]])))
print(f"eQTLGen 扫描 {n:,} 行，命中 {len(best)}/{len(hubs)} 个 hub 基因")

# eQTLGen 只给 Z，需 beta 与 se：se ≈ 1/sqrt(2*p*(1-p)*N)，用 MAF 近似不可得
# 采用标准做法：beta = Z / sqrt(2*MAF*(1-MAF)*(N + Z^2))，MAF 缺失时用 se = 1/sqrt(N) 近似
for g, d in best.items():
    N = d["n"] if d["n"] > 0 else 30000
    # 保守近似：se ≈ 1/sqrt(N)，beta ≈ Z/sqrt(N)
    d["se"] = 1.0 / math.sqrt(N)
    d["beta"] = d["z"] * d["se"]
    d["f"] = (d["beta"] / d["se"]) ** 2

keep = {g: d for g, d in best.items() if d["f"] > 10}
print(f"F>10 的工具变量: {len(keep)}/{len(best)}")

# ---- 2. FinnGen：按 rsid 提取 ----
want = {d["snp"] for d in keep.values()}
print("需要从 FinnGen 提取的 SNP:", len(want))
fin = {}
with gzip.open(FINN, "rt", encoding="utf-8", errors="replace") as f:
    hdr = f.readline().lstrip("#").rstrip("\n").split("\t")
    idx = {c: i for i, c in enumerate(hdr)}
    for line in f:
        p = line.rstrip("\n").split("\t")
        if len(p) < len(hdr): continue
        rs = p[idx["rsids"]]
        if rs in want:
            fin[rs] = dict(beta=float(p[idx["beta"]]), se=float(p[idx["sebeta"]]),
                           ea=p[idx["alt"]], oa=p[idx["ref"]], p=float(p[idx["pval"]]),
                           gene=p[idx["nearest_genes"]])
print(f"FinnGen 命中 {len(fin)}/{len(want)} 个 SNP")

# ---- 3. Wald ratio ----
rows = []
for g, d in keep.items():
    rs = d["snp"]
    if rs not in fin: continue
    o = fin[rs]
    # 对齐等位基因
    if d["ea"] == o["ea"] and d["oa"] == o["oa"]:
        b_out = o["beta"]
    elif d["ea"] == o["oa"] and d["oa"] == o["ea"]:
        b_out = -o["beta"]
    else:
        continue  # 等位基因不一致（可能是链翻转），跳过
    b_exp = d["beta"]
    if b_exp == 0: continue
    ratio = b_out / b_exp
    se_ratio = abs(o["se"] / b_exp)
    z = ratio / se_ratio if se_ratio > 0 else 0
    p = 2 * (1 - 0.5 * (1 + math.erf(abs(z) / math.sqrt(2))))
    rows.append([g, rs, round(d["beta"], 4), round(d["se"], 4), round(d["f"], 1),
                 round(b_out, 4), round(o["se"], 4), round(ratio, 4), round(se_ratio, 4),
                 round(z, 2), f"{p:.3g}"])

rows.sort(key=lambda r: float(r[10]))
with open(os.path.join(OUT, "mr_results.tsv"), "w", encoding="utf-8", newline="") as f:
    w = csv.writer(f, delimiter="\t")
    w.writerow(["gene", "SNP", "beta_exposure", "se_exposure", "F",
                "beta_outcome", "se_outcome", "Wald_ratio", "se_ratio", "z", "P"])
    w.writerows(rows)

print(f"\n=== cis-MR 结果（{len(rows)} 个基因）===")
print(f"{'基因':10s} {'SNP':14s} {'F':>7s} {'OR':>7s} {'P':>10s}")
for r in rows:
    print(f"{r[0]:10s} {r[1]:14s} {r[4]:7.1f} {math.exp(float(r[7])):7.3f} {r[10]:>10s}")

sig = [r for r in rows if float(r[10]) < 0.05]
print(f"\nP<0.05: {len(sig)} 个")
print("完成 ->", os.path.join(OUT, "mr_results.tsv"))


"""background_comparison.py — 计算配方级靶点集在两种背景下的 KEGG 富集

统一规则（与 Methods 一致）：
  可测通路 = 背景宇宙内基因数在 5–400 之间，且被查询集命中至少 1 个
  超几何检验 + Benjamini–Hochberg（全部可测通路内校正）
输出：results/background_comparison.tsv
"""
import sys, math, csv
from pathlib import Path
from collections import defaultdict

_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(_ROOT))
from config import ROOT, RESULTS, RAW, PROCESSED


def read_gmt(p):
    out = {}
    for line in open(p, encoding="utf-8"):
        f = line.rstrip("\n").split("\t")
        if len(f) > 2:
            out[f[0]] = {x.upper() for x in f[2:] if x}
    return out


def hypergeom_tail(Kc, N, n, x):
    return sum(math.comb(Kc, i) * math.comb(N - Kc, n - i)
               for i in range(x, min(Kc, n) + 1)) / math.comb(N, n)


K = read_gmt(RAW / "kegg" / "KEGG_2021_Human.gmt")
all_kegg = set().union(*K.values())

herb_t = set()
for line in open(PROCESSED / "herb_targets_v2.tsv", encoding="utf-8"):
    f = line.rstrip("\n").split("\t")
    if len(f) > 1:
        herb_t.add(f[1].upper())
OMEGA = herb_t & all_kegg

XYS = {l.split("\t")[0].strip().upper() for l in
       open(PROCESSED / "XYS_targets_OB30DL018.tsv", encoding="utf-8")} - {""}
XYS &= all_kegg


def enrich(universe, label):
    rows = []
    for pw, genes in K.items():
        Kc = len(genes & universe)
        if not (5 <= Kc <= 400):
            continue
        hit = len(XYS & genes)
        if hit == 0:
            continue
        rows.append([pw, hit, Kc, hypergeom_tail(Kc, len(universe), len(XYS), hit)])
    rows.sort(key=lambda r: r[3])
    m = len(rows)
    for i, r in enumerate(rows):
        r.append(min(1.0, r[3] * m / (i + 1)))
    sig = sum(1 for r in rows if r[4] < 0.05)
    print(f"{label}: 查询 {len(XYS)} | 宇宙 {len(universe)} | 可测 {m} | FDR<0.05 {sig} "
          f"({100*sig/m:.0f}%)")
    for r in rows[:8]:
        print(f"    {r[0][:44]:44s} hit={r[1]:3d} K={r[2]:4d} FDR={r[4]:.2e}")
    return rows, sig


print("=== 背景对比：同一 241 靶点集 ===")
g, sg = enrich(all_kegg, "全基因组")
print()
h, sh = enrich(OMEGA, "中药靶点宇宙")

with open(RESULTS / "background_comparison.tsv", "w", encoding="utf-8", newline="") as f:
    w = csv.writer(f, delimiter="\t")
    w.writerow(["pathway", "hits", "K_genome", "P_genome", "FDR_genome",
                "K_herbal", "P_herbal", "FDR_herbal"])
    gd = {r[0]: r for r in g}
    hd = {r[0]: r for r in h}
    for pw in sorted(set(gd) | set(hd)):
        gg, hh = gd.get(pw), hd.get(pw)
        w.writerow([pw,
                    (gg or hh)[1],
                    gg[2] if gg else "", f"{gg[3]:.3e}" if gg else "", f"{gg[4]:.3e}" if gg else "",
                    hh[2] if hh else "", f"{hh[3]:.3e}" if hh else "", f"{hh[4]:.3e}" if hh else ""])
print("\n已写出 results/background_comparison.tsv")
print(f"摘要用数字: 全基因组 {sg}/{len(g)} ({100*sg/len(g):.0f}%), "
      f"中药宇宙 {sh}/{len(h)} ({100*sh/len(h):.0f}%)")

"""diagnostic_ML.py — 诊断性能(ROC/AUC) + 机器学习驱动 hub 基因与靶点集的重叠

Requires data/processed/expr_blood_full.tsv, generated from GEO GSE98793 by
R/05_build_deg_GSE98793.R (48 MB; not redistributed here).

回答两个问题：
  1. 靶点集分数能否区分 MDD 与对照（AUC）？
  2. 用三种机器学习方法从数据里选出的 hub 基因，是否与 XYS 靶点集重叠？
"""
import sys
from pathlib import Path
_ROOT = Path(__file__).resolve().parents[1]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))
sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import ROOT
import sys, warnings
from pathlib import Path
warnings.filterwarnings("ignore")
import numpy as np
import pandas as pd
from sklearn.linear_model import LogisticRegressionCV
from sklearn.svm import LinearSVC
from sklearn.ensemble import RandomForestClassifier
from sklearn.feature_selection import RFE
from sklearn.model_selection import StratifiedKFold, cross_val_predict
